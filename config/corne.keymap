#define HOST_OS 1

#include "keymap_french.h"
#include "helper.h"
#include "french_unicode.dtsi"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        #include "macros.dtsi"

        left_ctrl: left_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFT_CTRL";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
            hold-while-undecided;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39 36 37 38>;
            bindings = <&kp>, <&kp>;
        };

        right_ctrl: right_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHT_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            flavor = "tap-unless-interrupted";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwerty {
            // -----------------------------------------------------------------------------------------------------------
            // |  TAB#0 |  Q#1  |  W#2  |  E#3  |  R#4  |  T#5  |   |  Y#6  |  U#7   |  I#8  |  O#9  |  P#10  | BKSP#11 |
            // | CTRL#12|  A#13 |  S#14 |  D#15 |  F#16 |  G#17 |   |  H#18 |  J#19  |  K#20 |  L#21 |  ;#22  |  '#23   |
            // | SHFT#24|  Z#25 |  V#26 |  X#27 |  C#28 |  B#29 |   |  N#30 |  M#31  |  ,#32 |  .#33 |  /#34  | ESC#35  |
            //                          | GUI#36| LWR#37| SPC#38|   | ENT#39| RSE#40 | ALT#41|

            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R               &kp T           &kp Y       &kp U                &kp I         &kp O    &kp P     &kp BACKSLASH
&kp LEFT_CONTROL  &kp A  &kp S  &kp D  &left_ctrl LCTRL F  &kp G           &kp H       &right_ctrl RCTRL J  &kp K         &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp V  &kp X  &kp C               &kp B           &kp N       &kp M                &kp COMMA     &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &mo 2  &mo 1               &kp LEFT_ALT    &kp ESCAPE  &kp SPACE            &kp LEFT_WIN
            >;
        };

        number {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp C_AL_SPELLCHECK  &kp EXCLAMATION  &kp AT_SIGN   &kp POUND     &kp DOLLAR                        &kp PERCENT    &kp AMPERSAND  &kp LEFT_PARENTHESIS                     &kp RIGHT_PARENTHESIS  &kp MINUS  &kp EQUAL  &trans
&kp LEFT_CONTROL     &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &left_ctrl LEFT_CONTROL NUMBER_4  &kp N5         &kp ASTERISK   &right_ctrl RIGHT_CONTROL RIGHT_BRACKET  &kp RIGHT_BRACKET      &kp GRAVE  &kp TILDE  &trans
&kp LSHFT            &kp NUMBER_6     &kp N7        &kp N8        &kp N9                            &kp N0         &kp CARET      &kp BACKSPACE                            &trans                 &trans     &trans     &trans
                                                    &trans        &trans                            &trans         &kp RET        &kp TAB                                  &trans
            >;
        };

        system {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp LA(TAB)  &trans            &trans            &trans            &trans            &trans              &trans    &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC
&kp LCTRL    &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(NUMBER_5)    &kp LEFT  &kp DOWN           &kp UP_ARROW     &kp RIGHT   &trans                &trans
&kp ENTER    &kp LG(NUMBER_6)  &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &kp LG(NUMBER_0)    &trans    &trans             &trans           &trans      &trans                &trans
                                                 &trans            &trans            &bootloader         &kp RET   &trans             &mo 3
            >;
        };

        media_ext {
            bindings = <
&trans  &trans  &trans          &trans      &trans            &trans    &trans      &trans        &trans        &trans        &trans        &out OUT_TOG
&trans  &trans  &kp C_PREVIOUS  &kp C_NEXT  &kp C_PLAY_PAUSE  &trans    &trans      &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans          &trans      &trans            &trans    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                                &trans      &trans            &trans    &trans      &trans        &trans
            >;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_del {
            timeout-ms = <50>;
            key-positions = <12 18>;
            bindings = <&kp BACKSPACE>;
        };

        combo_enter {
            timeout-ms = <200>;
            key-positions = <12 31>;
            bindings = <&kp RET>;
        };
    };
};
